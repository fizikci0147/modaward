# ───────────────────────────── ModaWard configuration ─────────────────────────────
# Copy to `.env` (or set these in your host's environment panel). Everything is optional
# except APP_URL in production. The app boots with none of them set.

# ── Server ──
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
# 1 when the app sits behind a reverse proxy / hosting panel (Hostinger, Nginx, Cloudflare)
TRUST_PROXY=1
# Your public address, no trailing slash. REQUIRED in production: used in password-reset emails
# and Stripe return links (never derived from request headers, which can be forged).
APP_URL=https://yourdomain.com

# Where the SQLite database, photos and secrets live. Keep it OUTSIDE the app folder so
# redeploys never wipe it. Default: ~/modaward-data (falls back to ./data).
# DATA_DIR=/home/youruser/modaward-data

# ── Weather ──
# openmeteo (default) | mock (offline demo data)
WEATHER_PROVIDER=openmeteo
# Open-Meteo's free endpoint is for NON-COMMERCIAL use. A paid product needs a commercial
# subscription: https://open-meteo.com/en/pricing  → put its key here.
OPEN_METEO_API_KEY=

# ── Email (password resets). Hostinger mailbox example ──
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=
SMTP_FROM=ModaWard <no-reply@yourdomain.com>

# ── Reminders and push notifications ──
# Push works with no setup: VAPID keys are generated once and kept in DATA_DIR/secrets.
# Set these only to bring your own keys, or to switch a part off.
# PUSH_ENABLED=true
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourdomain.com
# REMINDERS_ENABLED=true
# REMINDERS_INTERVAL_SECONDS=300

# ── Pro subscriptions (Stripe) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# ── AI stylist + photo auto-tagging (Anthropic Claude) ──
ANTHROPIC_API_KEY=
# claude-opus-5-5 is the default. claude-sonnet-5-5 costs about half as much per call.
# AI_MODEL=claude-opus-5-5
# Max AI calls per user per day, and across all users per day (cost safety valves)
AI_DAILY_LIMIT=12
AI_GLOBAL_DAILY_LIMIT=2000

# ── High-accuracy background removal fallback (remove.bg), Pro only ──
REMOVEBG_API_KEY=
CUTOUT_DAILY_LIMIT=30

# ── Plan limits ──
FREE_CLOSET_LIMIT=30
FREE_SHOP_LOOKS=6

# ── Business ──
# Who runs this site. Shown in the Privacy Policy as the person to contact (required in many countries)
OPERATOR_NAME=
CONTACT_EMAIL=
# Comma-separated emails that can open the /admin dashboard
ADMIN_EMAILS=you@yourdomain.com
# Reset links are written to the server log only when SMTP is not set AND this is on (default: on outside production)
# LOG_MAIL_BODIES=0
# JSON file mapping retailer id → affiliate link template containing {url}, e.g.
# {"hm":"https://example.sjv.io/c/123/456/789?u={url}","zara":"https://click.linksynergy.com/deeplink?id=XXXX&mid=YYYY&murl={url}"}
AFFILIATE_CONFIG=

# ── Security / ops (rarely needed) ──
ALLOW_REGISTRATION=true
SESSION_DAYS=30
# ALLOWED_ORIGINS=https://www.yourdomain.com
# LINK_SECRET=            # signing secret for /go links (auto-generated and stored if empty)
AUTH_RATE_MAX=20
API_RATE_MAX=400

# Keep the fashion-trend lists current by themselves (monthly, needs ANTHROPIC_API_KEY). Off = built-in lists that fade as they age
# TRENDS_AUTO_REFRESH=1
